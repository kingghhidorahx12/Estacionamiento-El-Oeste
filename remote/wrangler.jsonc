{
  "name": "el-oeste-consulta",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "el-oeste-consulta", "database_id": "REEMPLAZAR_CON_ID_D1" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "REEMPLAZAR.cloudflareaccess.com", "ACCESS_AUD": "REEMPLAZAR_AUDIENCE_ACCESS" }
}
