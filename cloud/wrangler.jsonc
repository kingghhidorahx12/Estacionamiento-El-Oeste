{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-oeste-cloud",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "assets": {
    "directory": "../build/cloud-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "env": {
    "staging": {
      "name": "eloeste",
      "version_metadata": { "binding": "WORKER_VERSION" },
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "el-oeste-ensayo",
          "database_id": "d7552046-59b3-4236-b91c-ed9a904f064c",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-oeste-ensayo",
      "database_id": "d7552046-59b3-4236-b91c-ed9a904f064c"
    }
  ],
  "account_id": "54600c17d459514351dc3e040a7271cf"
}
